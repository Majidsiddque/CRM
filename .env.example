# Copy to .env for local use (never commit .env).
# PRODUCTION: Change app_user password in database and update here
DATABASE_URL=postgres://app_user:change_me@127.0.0.1:55432/postgres
PORT=3000
# NODE_ENV=production  # Set to production to disable /api/attack endpoint

# Razorpay TEST mode only (Dashboard -> toggle Test Mode -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks -> add URL, tick "payment_link.paid", set this secret
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string

# Video experiment: S3-compatible storage (AWS S3 or local RustFS)
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=crm-videos
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin-change-this
STORAGE_LIMIT_BYTES=524288000

# Protects job enqueue/list/replay endpoints. Use a long random value.
OPS_TOKEN=replace_with_a_long_random_secret
JOB_MAX_ATTEMPTS=5