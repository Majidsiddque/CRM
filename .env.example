# Copy to .env for local use (never commit .env).
DATABASE_URL=postgres://app_user:change_me@127.0.0.1:55432/postgres
PORT=3000

# Razorpay TEST mode only (Dashboard -> toggle Test Mode -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Dashboard -> Settings -> Webhooks -> add URL, tick "payment_link.paid", set this secret
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_string
